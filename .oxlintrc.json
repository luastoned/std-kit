{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": [
    "/build",
    "/node_modules",
    "docs/**",
    "lib/**",
    "coverage/**",
    "/dist"
  ],
  "overrides": [
    {
      "files": [
        "src/**/*.test.ts"
      ],
      "env": {
        "vitest": true
      }
    }
  ],
  "plugins": [
    "oxc",
    "typescript",
    "unicorn",
    "jsdoc"
  ],
  "rules": {}
}
