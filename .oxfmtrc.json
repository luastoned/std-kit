{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "ignorePatterns": [
    "/build",
    "docs/**",
    "lib/**",
    "coverage/**",
    "/dist",
    "/node_modules"
  ],
  "insertFinalNewline": true,
  "jsdoc": {
    "commentLineStrategy": "multiline",
    "lineWrappingStyle": "balance",
    "preferCodeFences": true
  },
  "printWidth": 160,
  "semi": true,
  "singleQuote": true,
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      "internal",
      [
        "parent",
        "sibling",
        "index"
      ],
      "style",
      "unknown"
    ],
    "newlinesBetween": true
  },
  "sortPackageJson": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false
}
