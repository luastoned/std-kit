{
  "name": "std-kit",
  "version": "2.10.0",
  "private": false,
  "description": "NodeJS Standard Library Additions",
  "keywords": [
    "library",
    "node",
    "standard",
    "std",
    "typescript",
    "utilities"
  ],
  "homepage": "https://github.com/luastoned/std-kit",
  "license": "MIT",
  "author": "LuaStoned <npm@luastoned.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luastoned/std-kit.git"
  },
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./node": {
      "import": {
        "types": "./lib/node.d.mts",
        "default": "./lib/node.mjs"
      },
      "require": {
        "types": "./lib/node.d.cts",
        "default": "./lib/node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "yarn build:tsdown",
    "build:code": "tsc --project tsconfig.build.json",
    "build:tsdown": "tsdown",
    "build:types": "tsc --project tsconfig.build.json --declaration --emitDeclarationOnly",
    "check:exports": "node scripts/check-exports.mjs",
    "check:package": "npm pack --dry-run",
    "check:runtime": "node scripts/check-runtime.mjs",
    "clean": "rimraf coverage dist lib",
    "docs": "yarn docs:typedoc && yarn docs:transform",
    "docs:transform": "tsx scripts/transform-docs.ts",
    "docs:typedoc": "typedoc src/index.ts src/node.ts --excludeInternal --gitRevision main --intentionallyNotExported DeepAtomic --intentionallyNotExported DeepMergeArrays --intentionallyNotExported GetNestedField --intentionallyNotExported GetDirectOrIndexedField --json docs/documentation.json",
    "format": "yarn format:write",
    "format:check": "oxfmt --check ./src ./scripts ./*.config.mts",
    "format:write": "oxfmt ./src ./scripts ./*.config.mts",
    "lint": "yarn lint:check",
    "lint:check": "oxlint ./src ./scripts ./*.config.mts",
    "lint:fix": "oxlint --fix ./src ./scripts ./*.config.mts",
    "prepublishOnly": "yarn release:check",
    "release": "release-it",
    "release:artifacts": "yarn build && yarn docs && yarn check:exports && yarn check:package",
    "release:check": "yarn verify && yarn release:artifacts",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "verify": "yarn typecheck && yarn lint:check && yarn format:check && yarn test"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "release-it": "^21.0.2",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "yarn@1.22.22"
}
